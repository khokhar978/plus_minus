<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a1f12">

    <!-- QR Code Container -->
    <LinearLayout
        android:id="@+id/qrContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#1a4a2e"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan to Join"
            android:textSize="24sp"
            android:textColor="#f5f0e8"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:background="#ffffff"
            android:padding="8dp" />

        <TextView
            android:id="@+id/ipAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://192.168.1.X:8080"
            android:textSize="18sp"
            android:textColor="#4ade80"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/connectedPlayersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected: 0/4"
            android:textSize="20sp"
            android:textColor="#fbbf24"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join Game on Host"
            android:backgroundTint="#4ade80"
            android:textColor="#0a1f12"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:visibility="gone" />
            
        <Button
            android:id="@+id/btnStopServer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Server"
            android:backgroundTint="#ef4444"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
            
    </LinearLayout>

    <!-- Game UI WebView -->
    <WebView
        android:id="@+id/gameWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
